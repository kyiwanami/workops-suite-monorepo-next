{
  "name": "workops-suite-monorepo-next",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint packages/backend/amplify packages/backend-portal/amplify packages/blocks packages/server apps/portal/src",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "sandbox": "npm --node-options=--conditions=cdk run sandbox --workspace=@workops/backend --",
    "dev:portal": "npm run dev --workspace=@workops/portal",
    "sandbox:portal": "npm run sandbox --workspace=@workops/backend-portal --"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
